<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:layout_gravity="center"
    tools:context=".chooselanguage">


    <AutoCompleteTextView
        android:id="@+id/language_search"
        android:layout_width="231dp"
        android:layout_height="52dp"
        android:background="@drawable/edit_text_passport"
        android:completionThreshold="1"
        android:drawableLeft="@android:drawable/ic_menu_search"
        android:dropDownHeight="wrap_content"
        android:dropDownVerticalOffset="8dp"
        android:hint="Search language"
        android:padding="12dp"
        android:textColor="#006644"
        android:textColorHint="#006644"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.386" />

    <Button
        android:id="@+id/letsgo"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:backgroundTint="#006644"
        android:fontFamily="sans-serif-medium"
        android:text="Start, Let's Go!!"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/language_search"
        app:layout_constraintVertical_bias="0.056" />


</androidx.constraintlayout.widget.ConstraintLayout>