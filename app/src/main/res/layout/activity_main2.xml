<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:cardView="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/your_background_image"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            cardView:cardCornerRadius="24dp"
            cardView:cardElevation="8dp"
            android:backgroundTint="#008A5E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELECT TRAIN"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="24dp" />

                <!-- From Station -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="From"
                    android:textColor="@android:color/white" />

                <EditText
                    android:id="@+id/etFromStation"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="16dp"
                    android:drawableStart="@drawable/ic_train"
                    android:hint="From station"
                    android:backgroundTint="@android:color/white"
                    android:textColor="@android:color/white"
                    android:inputType="text" />

                <!-- To Station -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="To"
                    android:textColor="@android:color/white" />

                <EditText
                    android:id="@+id/etToStation"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="16dp"
                    android:drawableStart="@drawable/ic_train"
                    android:hint="To station"
                    android:backgroundTint="@android:color/white"
                    android:textColor="@android:color/white"
                    android:inputType="text" />

                <!-- Station Details Button -->
                <Button
                    android:id="@+id/btnStationDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Station Details"
                    android:backgroundTint="@android:color/white"
                    android:textColor="#008A5E"
                    android:layout_marginBottom="24dp" />

                <!-- Train Number -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Train number"
                    android:textColor="@android:color/white" />

                <EditText
                    android:id="@+id/etTrainNumber"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="24dp"
                    android:hint="Enter train number"
                    android:backgroundTint="@android:color/white"
                    android:textColor="@android:color/white"
                    android:inputType="number" />

                <!-- Search Button -->
                <Button
                    android:id="@+id/btnSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SEARCH"
                    android:backgroundTint="@android:color/white"
                    android:textColor="#008A5E"
                    android:layout_marginBottom="16dp" />

                <!-- Current Status Button -->
                <Button
                    android:id="@+id/btnCurrentStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEARCH"
                    android:backgroundTint="@android:color/white"
                    android:textColor="#008A5E" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_centerInParent="true" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:maxHeight="200dp"
            android:scrollbars="vertical"
            android:overScrollMode="always"
            android:background="@color/white"
            android:hint="Your result will show here"
            android:textColorHint="@color/black"
            android:textColor="@android:color/black"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>
